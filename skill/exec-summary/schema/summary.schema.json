{
  "$comment": "Shape of summary.json. validate.py reads this file, so it is the single source of truth. Only these keywords are supported: type, required, properties, additionalProperties (false), items, enum, minItems, maxItems, minLength, maxLength.",
  "type": "object",
  "required": ["project", "sources", "skipped"],
  "additionalProperties": false,
  "properties": {
    "project": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "tagline": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "maxLength": 80 },
        "date": { "type": "string", "maxLength": 40 }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["path"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 300 },
          "modified": { "type": "string", "maxLength": 40 },
          "found": { "type": "array", "maxItems": 30, "items": { "type": "string", "maxLength": 60 } }
        }
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["src", "reason"],
        "additionalProperties": false,
        "properties": {
          "src": { "type": "string", "minLength": 1, "maxLength": 300 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    },
    "goal": {
      "type": "object",
      "required": ["text", "src"],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "type": "string", "minLength": 1, "maxLength": 400 }
        },
        "src": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "stories": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "required": ["id", "as", "want", "so", "src"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 20 },
          "as": { "type": "string", "minLength": 1, "maxLength": 120 },
          "want": { "type": "string", "minLength": 1, "maxLength": 300 },
          "so": { "type": "string", "minLength": 1, "maxLength": 300 },
          "criteria": {
            "type": "array",
            "maxItems": 20,
            "items": { "type": "string", "minLength": 1, "maxLength": 300 }
          },
          "src": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    },
    "data": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": ["name", "plain", "src"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "plain": { "type": "string", "minLength": 1, "maxLength": 300 },
          "fields": {
            "type": "array",
            "maxItems": 20,
            "items": { "type": "string", "minLength": 1, "maxLength": 80 }
          },
          "src": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    },
    "stack": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": ["part", "choice", "plain", "src"],
        "additionalProperties": false,
        "properties": {
          "part": { "type": "string", "minLength": 1, "maxLength": 80 },
          "choice": { "type": "string", "minLength": 1, "maxLength": 120 },
          "plain": { "type": "string", "minLength": 1, "maxLength": 300 },
          "src": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    },
    "rules": {
      "type": "object",
      "required": ["src"],
      "additionalProperties": false,
      "properties": {
        "always": {
          "type": "array",
          "maxItems": 15,
          "items": { "type": "string", "minLength": 1, "maxLength": 300 }
        },
        "ask_first": {
          "type": "array",
          "maxItems": 15,
          "items": { "type": "string", "minLength": 1, "maxLength": 300 }
        },
        "never": {
          "type": "array",
          "maxItems": 15,
          "items": { "type": "string", "minLength": 1, "maxLength": 300 }
        },
        "src": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "decisions": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "required": ["text", "src"],
        "additionalProperties": false,
        "properties": {
          "text": { "type": "string", "minLength": 1, "maxLength": 400 },
          "src": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    },
    "out_of_scope": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "required": ["text", "src"],
        "additionalProperties": false,
        "properties": {
          "text": { "type": "string", "minLength": 1, "maxLength": 400 },
          "src": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    },
    "success": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "required": ["text", "src"],
        "additionalProperties": false,
        "properties": {
          "text": { "type": "string", "minLength": 1, "maxLength": 400 },
          "phase": { "type": "string", "maxLength": 80 },
          "src": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    },
    "notes": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": ["title", "text", "src"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 80 },
          "text": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": { "type": "string", "minLength": 1, "maxLength": 400 }
          },
          "src": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    },
    "phases": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["id", "title", "src"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 20 },
          "title": { "type": "string", "minLength": 1, "maxLength": 100 },
          "goal": { "type": "string", "maxLength": 300 },
          "tasks": {
            "type": "array",
            "maxItems": 40,
            "items": {
              "type": "object",
              "required": ["id", "title", "src"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 20 },
                "title": { "type": "string", "minLength": 1, "maxLength": 120 },
                "you_will_see": { "type": "string", "maxLength": 300 },
                "src": { "type": "string", "minLength": 1, "maxLength": 300 }
              }
            }
          },
          "src": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    },
    "checkpoints": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["title", "items", "src"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 100 },
          "phase": { "type": "string", "maxLength": 100 },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": { "type": "string", "minLength": 1, "maxLength": 300 }
          },
          "src": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    },
    "risks": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["risk", "impact", "handling", "src"],
        "additionalProperties": false,
        "properties": {
          "risk": { "type": "string", "minLength": 1, "maxLength": 300 },
          "impact": { "type": "string", "enum": ["High", "Med", "Low"] },
          "handling": { "type": "string", "minLength": 1, "maxLength": 400 },
          "src": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    },
    "screens": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["title", "blocks"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 80 },
          "example": { "type": "boolean" },
          "blocks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "object",
              "required": ["type", "label"],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["header", "nav", "stats", "chart", "list", "form", "button", "text", "image"]
                },
                "label": { "type": "string", "minLength": 1, "maxLength": 120 }
              }
            }
          },
          "src": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    },
    "diagrams": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["id", "kind", "title", "nodes", "edges", "src"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 40 },
          "kind": { "type": "string", "enum": ["architecture", "flow"] },
          "title": { "type": "string", "minLength": 1, "maxLength": 100 },
          "nodes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "object",
              "required": ["id", "label"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 40 },
                "label": { "type": "string", "minLength": 1, "maxLength": 80 },
                "group": { "type": "string", "maxLength": 80 }
              }
            }
          },
          "edges": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "type": "object",
              "required": ["from", "to"],
              "additionalProperties": false,
              "properties": {
                "from": { "type": "string", "minLength": 1, "maxLength": 40 },
                "to": { "type": "string", "minLength": 1, "maxLength": 40 },
                "label": { "type": "string", "maxLength": 60 }
              }
            }
          },
          "src": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "maxItems": 30,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    }
  }
}
