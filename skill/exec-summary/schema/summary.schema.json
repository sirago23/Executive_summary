{
  "$comment": "Shape of summary.json. validate.py reads this file, so it is the single source of truth. Only these keywords are supported: type, required, properties, additionalProperties (false), items, enum, minItems, maxItems, minLength, maxLength.",
  "type": "object",
  "required": ["project", "sources", "skipped"],
  "additionalProperties": false,
  "properties": {
    "project": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "tagline": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "maxLength": 80 },
        "date": { "type": "string", "maxLength": 40 }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["path"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 300 },
          "modified": { "type": "string", "maxLength": 40 },
          "found": { "type": "array", "maxItems": 30, "items": { "type": "string", "maxLength": 60 } }
        }
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["src", "reason"],
        "additionalProperties": false,
        "properties": {
          "src": { "type": "string", "minLength": 1, "maxLength": 300 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    },
    "goal": {
      "type": "object",
      "required": ["text", "src"],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "type": "string", "minLength": 1, "maxLength": 400 }
        },
        "src": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "stories": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "required": ["id", "as", "want", "so", "src"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 20 },
          "as": { "type": "string", "minLength": 1, "maxLength": 120 },
          "want": { "type": "string", "minLength": 1, "maxLength": 300 },
          "so": { "type": "string", "minLength": 1, "maxLength": 300 },
          "src": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "maxItems": 30,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    }
  }
}
